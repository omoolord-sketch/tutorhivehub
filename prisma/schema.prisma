  updatedAt               DateTime  @updatedAt

  @@index([planType])
  @@index([subjectId])
  @@index([examPathway])
  @@index([status])
}

model Homework {
  id          String         @id @default(cuid())
  studentId   String
  student     Student        @relation(fields: [studentId], references: [id])
  tutorId     String?
  tutor       Tutor?         @relation(fields: [tutorId], references: [id])
  lessonId    String?
  lesson      Lesson?        @relation(fields: [lessonId], references: [id])
  subjectId   String?
  subject     Subject?       @relation(fields: [subjectId], references: [id])
  title       String
  details     String         @db.Text
  instructions String?       @db.Text
  gradingCriteria String?    @db.Text
  maxMarks    Decimal?       @db.Decimal(6, 2)
  mark        Decimal?       @db.Decimal(6, 2)
  feedback    String?        @db.Text
  attachments Json?
  resources   Resource[]
  submissions HomeworkSubmission[]
  dueDate     DateTime?
  status      HomeworkStatus @default(ASSIGNED)
  publishedAt DateTime?
  submittedAt DateTime?
  reviewedAt DateTime?
  completedAt DateTime?
  resubmissionRequestedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([studentId])
  @@index([tutorId])
  @@index([lessonId])
  @@index([subjectId])
  @@index([status])
  @@index([dueDate])
}

model HomeworkSubmission {
  id            String    @id @default(cuid())
  homeworkId    String
  homework      Homework  @relation(fields: [homeworkId], references: [id])
  studentId     String
  student       Student   @relation(fields: [studentId], references: [id])
  submittedById String?
  submittedBy   User?     @relation("HomeworkSubmittedBy", fields: [submittedById], references: [id])
  comments      String?   @db.Text
  fileKey       String?
  fileName      String?
  fileMimeType  String?
  fileSize      Int?
  status        String    @default("SUBMITTED")
  mark          Decimal?  @db.Decimal(6, 2)
  feedback      String?   @db.Text
  reviewedById  String?
  reviewedBy    User?     @relation("HomeworkReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([homeworkId])
  @@index([studentId])
  @@index([submittedById])
  @@index([reviewedById])
  @@index([status])
}

model Resource {
  id            String             @id @default(cuid())
  title         String
  description   String?             @db.Text
  url           String?             @db.VarChar(2048)
  fileKey       String?
  fileName      String?
  fileMimeType  String?
  fileSize      Int?
  resourceType  ResourceType       @default(DOCUMENT)
  visibility    ResourceVisibility @default(INTERNAL)
  subjectId     String?
  subject       Subject?           @relation(fields: [subjectId], references: [id])
  tutorId       String?
  tutor         Tutor?             @relation(fields: [tutorId], references: [id])
  studentId     String?
  student       Student?           @relation(fields: [studentId], references: [id])
  lessonId      String?
  lesson        Lesson?            @relation(fields: [lessonId], references: [id])
  yearGroup     String?
  examPathway   String?
  status        String             @default("ACTIVE")
  createdById   String?
  createdBy     User?              @relation("ResourceCreatedBy", fields: [createdById], references: [id])
  approvedById  String?
  approvedBy    User?              @relation("ResourceApprovedBy", fields: [approvedById], references: [id])
  approvedAt    DateTime?
  homework      Homework[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([subjectId])
  @@index([tutorId])
  @@index([studentId])
  @@index([lessonId])
  @@index([createdById])
  @@index([approvedById])
  @@index([resourceType])
  @@index([visibility])
  @@index([status])
  @@index([yearGroup])
  @@index([examPathway])
}

